{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode — required for relative imports like "./supabase"
       and "../database/db" to resolve under Vite. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* The single most important line for your errors — registers the
       react-jsx runtime so JSX.IntrinsicElements and react/jsx-runtime
       resolve. Without this, every <div>, <button>, <svg>... fails with
       "JSX element implicitly has type 'any'". */
    "jsx": "react-jsx",

    /* Lint-style checks — keep them strict; your code already passes. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
