
{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/medstat/",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "/medstat/admin",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "/medstat/admin/:path*",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/medstat/login",
      "permanent": false
    },
    {
      "source": "/register",
      "destination": "/medstat/register",
      "permanent": false
    },
    {
      "source": "/trainer",
      "destination": "/medstat/trainer",
      "permanent": false
    },
    {
      "source": "/trainer/:path*",
      "destination": "/medstat/trainer/:path*",
      "permanent": false
    },
    {
      "source": "/user",
      "destination": "/medstat/user",
      "permanent": false
    },
    {
      "source": "/user/:path*",
      "destination": "/medstat/user/:path*",
      "permanent": false
    },
    {
      "source": "/forms",
      "destination": "/medstat/forms",
      "permanent": false
    },
    {
      "source": "/forms/:path*",
      "destination": "/medstat/forms/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/medstat/api/api/:path*",
      "destination": "https://medstat-3rxl.onrender.com/api/:path*"
    },
    {
      "source": "/medstat/api/:path*",
      "destination": "https://medstat-3rxl.onrender.com/api/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://medstat-3rxl.onrender.com/api/:path*"
    },
    {
      "source": "/medstat/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/medstat/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
