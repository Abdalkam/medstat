{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/medstat/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/medstat/api/api/:path*", "destination": "https://medstat-3rxl.onrender.com/api/:path*" },
    { "source": "/medstat/api/:path*", "destination": "https://medstat-3rxl.onrender.com/api/:path*" },
    { "source": "/api/:path*", "destination": "https://medstat-3rxl.onrender.com/api/:path*" },
    { "source": "/medstat/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/medstat/:path*", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}