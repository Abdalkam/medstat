{
    "framework":  "vite",
    "buildCommand":  "npm run build",
    "outputDirectory":  "dist",
    "rewrites":  [
                     {
                         "source":  "/medstat/api/:path*",
                         "destination":  "/api/:path*"
                     },
                     {
                         "source":  "/medstat/:path*",
                         "destination":  "/:path*"
                     },
                     {
                         "source":  "/(.*)",
                         "destination":  "/index.html"
                     }
                 ]
}
